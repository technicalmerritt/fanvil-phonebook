# Copy to .env and fill in. Never commit .env.
SYNCRO_SUBDOMAIN=technicalmerritt
# A Custom Permissions API token made for the till only (Admin > API > API Tokens).
SYNCRO_TOKEN=
# The walk-in customer that counter sales are invoiced to.
POS_CUSTOMER_ID=20760699
# dry  = practice mode, nothing is written to Syncro (default)
# live = sales create real invoices and payments. Requires TILL_PIN.
SALES_MODE=dry
# PIN staff type to unlock the till. Required in live mode.
TILL_PIN=
# Payment method names exactly as they appear in Syncro.
CARD_METHOD=Dojo card
CASH_METHOD=Cash
PORT=8787
