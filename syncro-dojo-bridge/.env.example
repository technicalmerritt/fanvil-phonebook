# ---------------------------------------------------------------------------
# Syncro <-> Dojo bridge configuration
#
# Copy this file to `.env` and replace every <PLACEHOLDER>.
# `.env` is gitignored - never commit real keys.
# ---------------------------------------------------------------------------

# === Bridge ================================================================
# Shared secret the till UI / bookmarklet uses to talk to this service.
# Invent a long random one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_TOKEN=<INVENT_A_LONG_RANDOM_STRING>

PORT=8787
# Keep this on localhost unless another machine needs to reach the bridge.
# If you change it to 0.0.0.0, put the bridge behind HTTPS.
HOST=127.0.0.1

# Only needed if you call the API directly from a browser page on another
# origin. The bookmarklet does NOT need this (it opens a window instead).
# ALLOWED_ORIGINS=https://<YOUR_SYNCRO_SUBDOMAIN>.syncromsp.com


# === Syncro ================================================================
# "yourfirm" from https://yourfirm.syncromsp.com
SYNCRO_SUBDOMAIN=<YOUR_SYNCRO_SUBDOMAIN>

# Syncro -> Admin -> API Tokens -> New Token.
# Permissions needed: Invoices (view), Payments (view list + create).
SYNCRO_API_KEY=<YOUR_SYNCRO_API_TOKEN>

# Full base URL override. Only needed for non-.com tenants, e.g.
# https://yourfirm.syncromsp.eu/api/v1
# SYNCRO_API_BASE=

# How the token is sent. Default "Bearer". If Syncro rejects it with a 401,
# try an empty value here, which sends the bare key.
SYNCRO_AUTH_SCHEME=Bearer

# The label this payment gets in Syncro. Must match one of your Syncro
# payment method names, or Syncro may reject the payment.
SYNCRO_PAYMENT_METHOD=Credit Card

# Invoice field holding the outstanding balance. See README "Verify points".
SYNCRO_BALANCE_FIELD=balance_due

# Set to false to take the card payment but NOT write it back to Syncro
# (useful for a first live test).
SYNCRO_RECORD_PAYMENT=true


# === Dojo ==================================================================
DOJO_API_BASE=https://api.dojo.tech

# developer.dojo.tech -> your app -> keys.
#   sk_sandbox_...  while testing
#   sk_prod_...     when taking real money
DOJO_API_KEY=<YOUR_DOJO_SECRET_KEY>

# Dojo issues these two when they onboard you as an EPOS integrator.
DOJO_SOFTWARE_HOUSE_ID=<YOUR_DOJO_SOFTWARE_HOUSE_ID>
DOJO_RESELLER_ID=<YOUR_DOJO_RESELLER_ID>

# Dojo API version header. Confirm the current value in your Dojo portal.
DOJO_API_VERSION=2024-02-05

# Pin a specific card machine, or leave blank to auto-pick an Available one.
# The setup page lists the ids the bridge can see.
# DOJO_TERMINAL_ID=<YOUR_DOJO_TERMINAL_ID>

DOJO_CURRENCY=GBP

# Auto   = taken as soon as the customer's card is authorised (normal retail)
# Manual = authorised only; you capture it later with a separate call
DOJO_CAPTURE_MODE=Auto


# === Charge behaviour ======================================================
# How often to ask Dojo whether the customer has paid yet.
POLL_INTERVAL_MS=1500

# Give up and cancel at the machine after this long (3 minutes).
CHARGE_TIMEOUT_MS=180000

# Refuse any single sale above this, in PENCE. A safety net against a
# mistyped amount or a bad invoice total. 500000 = £5,000.00
MAX_AMOUNT_MINOR=500000

# Audit trail location.
# LEDGER_PATH=./data/ledger.jsonl
